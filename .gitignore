# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/


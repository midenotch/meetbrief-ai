# =============================================================================
# Environments & Secrets (CRITICAL: Never commit real credentials or secrets)
# =============================================================================
.env
.env*
*.env
*.env.*
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example config files to be committed for documentation
!.env.example
!*.example

# Keys and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12


# =============================================================================
# MeetBrief AI — Environment Variables Template
# Copy this file to .env and replace the placeholder values with your real keys.
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Database & Authentication)
# Obtain these from: Supabase Dashboard → Settings → API & JWT Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -----------------------------------------------------------------------------
# AI PROVIDERS (Configure at least one: Anthropic or Google Gemini)
# If both are provided, Anthropic is primary and Gemini acts as secondary.
# -----------------------------------------------------------------------------
# Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-4-5

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# TAVILY SEARCH API (Autonomous Web Intelligence & 30-Day News Crawler)
# Sign up at: https://app.tavily.com
# -----------------------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key

# Optional: Groq Whisper API for server-side audio transcription
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# FASTAPI BACKEND CONFIGURATION
# -----------------------------------------------------------------------------
BACKEND_SECRET_KEY=change-me-to-a-secure-random-32-character-secret
ALLOWED_ORIGINS=http://localhost:3000
PORT=8000

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
# Local development default. Set to https://meetbrief-ai.onrender.com in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
